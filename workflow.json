      "parameters": {
        "jsCode": "// Lee los datos pineados del nodo HTTP Request (Lista de Precios)\nconst productos = $('HTTP Request').first().json.results;\n\n// Arma un texto simple: un producto por línea\nconst listaTexto = productos.map(item => {\n  const nombre = item.properties.Producto.title[0].plain_text;\n  const unidad = item.properties.Unidad.rich_text[0].plain_text;\n  const precio = item.properties.Precio.number;\n  return `${nombre} — $${precio} / ${unidad}`;\n}).join('\\n');\n\nreturn [{ json: { lista_precios_texto: listaTexto } }];"
      },
