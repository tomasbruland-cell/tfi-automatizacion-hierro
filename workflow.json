        "jsCode": "const form = $('On form submission').item.json;\n\nconst medidas = [\n  { medida: '06mm', cantidad: form['Hierro ADN x 06 mm — Cantidad'] },\n  { medida: '08mm', cantidad: form['Hierro ADN x 08 mm — Cantidad'] },\n  { medida: '10mm', cantidad: form['Hierro ADN x 10 mm — Cantidad'] },\n  { medida: '12mm', cantidad: form['Hierro ADN x 12 mm — Cantidad'] },\n  { medida: '16mm', cantidad: form['Hierro ADN x 16 mm — Cantidad'] },\n  { medida: '20mm', cantidad: form['Hierro ADN x 20 mm — Cantidad'] },\n  { medida: '25mm', cantidad: form['Hierro ADN x 25 mm — Cantidad'] },\n];\n\nconst detalle = medidas\n  .filter(m => Number(m.cantidad) > 0)\n  .map(m => `${m.cantidad}TN HIERRO ADN X ${m.medida}`)\n  .join(', ');\n\nconst cliente_id = $input.item.json.cliente_id;\n\nreturn [{ json: { detalle_pedido: detalle, cliente_id: cliente_id } }];"
